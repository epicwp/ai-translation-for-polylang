{
  "repositories": [],
  "require": {
    "automattic/jetpack-autoloader": "^3.1 || ^4.0 || ^5.0",
    "php-di/php-di": "^7.0 <7.1",
    "paquettg/php-html-parser": "^3.1",
    "php-jsonpatch/php-jsonpatch": "^4.1",
    "woocommerce/action-scheduler": "^3.9",
    "x-wp/di": "^2.0.0-alpha.5"
  },
  "require-dev": {
    "coenjacobs/mozart": "^0.7.1",
    "monolog/monolog": "^3.0",
    "oblak/wordpress-coding-standard": "^1",
    "php-stubs/wordpress-stubs": "^6.5",
    "php-stubs/wp-cli-stubs": "^2.11",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-deprecation-rules": "^1.1",
    "phpunit/phpunit": "^9.6",
    "swissspidy/phpstan-no-private": "^0.2.0",
    "symfony/var-dumper": "^6.4",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-phpunit/wp-phpunit": "^6.7",
    "wpsyntex/polylang-stubs": "^3.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "PLLAT\\": "src/Modules/",
      "PLLAT\\Common\\": "src/Common/",
      "PLLAT\\Dependencies\\": "vendor/prefixed/"
    },
    "classmap": [
      "src/App.php"
    ],
    "exclude-from-classmap": []
  },
  "autoload-dev": {
    "psr-4": {
      "PLLAT\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "automattic/jetpack-autoloader": true
    },
    "classmap-authoritative": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1"
    },
    "sort-packages": true
  },
  "scripts": {
    "mozart": [
      "@php -r \"if (file_exists('vendor/bin/mozart')) { passthru('vendor/bin/mozart compose'); }\""
    ],
    "post-install-cmd": [
      "@mozart",
      "composer dump-autoload"
    ],
    "post-update-cmd": [
      "@mozart",
      "composer dump-autoload"
    ],
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration --bootstrap tests/bootstrap.php",
    "stan": "phpstan analyse --no-progress",
    "cs": "phpcs",
    "cs:fix": "phpcbf"
  },
  "extra": {
    "release": {
      "name": "Polylang Automatic Translation with AI",
      "slug": "polylang-ai-automatic-translation"
    },
    "mozart": {
      "dep_namespace": "PLLAT\\Dependencies\\",
      "dep_directory": "/vendor/prefixed/",
      "classmap_directory": "/vendor/prefixed/classmap/",
      "classmap_prefix": "PLLAT_",
      "packages": [
        "monolog/monolog"
      ],
      "excluded_packages": [
        "x-wp/di"
      ],
      "delete_vendor_directories": true
    }
  }
}
